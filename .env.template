# Required: your Dynatrace platform environment URL
DT_ENVIRONMENT=https://abc12345.apps.dynatrace.com

# Authentication - choose ONE (or none for browser login):
# DT_PLATFORM_TOKEN=dt0s16.XXXX
# OAUTH_CLIENT_ID=dt0s02.SAMPLE
# OAUTH_CLIENT_SECRET=dt0s02.SAMPLE.ABCD1234

# Optional
# MAX_QUERY_TIMEFRAME=30d              # longest timeframe the query tools accept (e.g. 7d, 2w, 720h)
# DT_MCP_TOKEN_STORAGE=file
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# HTTP mode behind Azure API Management / Container Apps
# DQL_MAX_POLL_SECONDS=60              # cancel slow DQL queries (default: 60 in HTTP mode, 600 in stdio)
# MCP_UPSTREAM_SECRET=...              # APIM must send this in the header below; generate: openssl rand -base64 32
# MCP_UPSTREAM_SECRET_HEADER=x-from-apim
# MCP_FORWARDED_ALLOW_IPS=127.0.0.1    # proxies whose X-Forwarded-* headers are trusted (IPs/CIDRs, or *)
